# ==========================================
# InterviewAI Environment Configuration Template
# Copy relevant blocks to backend/.env and frontend/.env
# ==========================================

# ------------------------------------------
# BACKEND (backend/.env)
# ------------------------------------------
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=interview_ai
JWT_SECRET_KEY=replace_with_a_secure_random_secret_minimum_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Gemini AI API Configuration (Optional: uses smart NLP engine if empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Environment & Frontend URL
ENVIRONMENT=production
FRONTEND_URL=http://localhost:5173

# SMTP Email Delivery (Gmail / standard SMTP)
# For Gmail: Generate a 16-character App Password at https://myaccount.google.com/apppasswords
# If left empty in development, password reset flow is simulated safely without sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=InterviewAI
SMTP_USE_TLS=true

# ------------------------------------------
# FRONTEND (frontend/.env)
# ------------------------------------------
VITE_API_URL=http://localhost:8000
